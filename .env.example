# Copy to .env.local (never commit real values).
# Only EXPO_PUBLIC_* values are bundled into the app — they are NOT secret.

# Firebase: leave empty to keep everything on the device. See docs/CLOUD.md.
# Client config is public by design; security comes from firebase/firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Local testing only: point the app at the Firebase emulators, e.g. localhost
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# RevenueCat public SDK keys (Stage 6, sandbox first)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AI provider keys live ONLY in Cloud Functions secrets (firebase functions:secrets:set),
# never in this file or the app bundle.
