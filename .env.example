# Copy to .env.local (never commit real values). Not used yet in Stage 1.
# Only EXPO_PUBLIC_* values are bundled into the app — they are NOT secret.

# Firebase (Stage 2) — client config is public by design; security comes from rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat public SDK keys (Stage 6, sandbox first)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AI provider keys live ONLY in Cloud Functions secrets (firebase functions:secrets:set),
# never in this file or the app bundle.
