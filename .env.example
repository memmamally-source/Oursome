# Firebase web config for the Steps Ahead project (NOT any other app's project).
# These values are public identifiers, not secrets; security comes from Firestore rules.
# Leave empty to run fully on-device (guest mode).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 'development' | 'staging' | 'production'
VITE_APP_ENV=development
