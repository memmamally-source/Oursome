  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "axe-core": "^4.14.1",
    "html-validate": "^11.21.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
