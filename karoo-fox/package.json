{
  "name": "karoo-fox-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Karoo Fox corporate website (static, GitHub Pages).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "brand": "node scripts/brand-assets.mjs",
