---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Detail from '../../../components/Detail.astro';
import { apps, getApp } from '../../../data/apps.ts';
import { company } from '../../../config/company.ts';
import { appPaths, href } from '../../../lib/url.ts';

export const getStaticPaths = (() => apps.map((a) => ({ params: { slug: a.slug } }))) satisfies GetStaticPaths;

const app = getApp(Astro.params.slug);
const p = appPaths(app.slug);
const requestEmail = company.emails.privacy ?? app.supportEmail ?? null;
const subject = encodeURIComponent(`Delete my ${app.name} account and data`);
const body = encodeURIComponent(`Please delete my ${app.name} account and associated data.\n\nEmail address used for my account:\n\n`);
---
<Base title={`Delete your ${app.name} data`} description={`How to delete your ${app.name} account and data, in the app or by request.`}>
  <PageHeader title={`Delete your ${app.name} data`} eyebrow="Your data" lead={app.hasAccounts ? `You can delete your ${app.name} account and its data yourself in the app, or ask us to do it for you.` : `${app.name} has no accounts and keeps your data on your device.`} crumbs={[{ label: 'Apps', path: '/apps/' }, { label: app.name, path: p.page }, { label: 'Delete your data' }]} />
  <section class="section" aria-label="Instructions">
    <div class="narrow stack">
      <h2>{app.hasAccounts ? 'Delete your account in the app' : 'Remove your data'}</h2>
      <ol>
        {app.deletionSteps.map((s) => <li>{s}</li>)}
      </ol>
      {app.hasAccounts && (
        <>
          <p>Deleting your account removes your account and the data linked to it from our systems, as described in the <a href={href(p.privacy)}>{app.name} privacy policy</a>.</p>
          <h2>Can’t access the app? Ask us</h2>
          <p>Email us from the address linked to your account and we’ll delete it for you{app.deletionByEmailDays ? ` within ${app.deletionByEmailDays} days` : ''}. We may ask you to confirm the request to protect your account.</p>
          {requestEmail ? (
            <p><a class="button button--primary" href={`mailto:${requestEmail}?subject=${subject}&body=${body}`}>Email a deletion request</a></p>
          ) : (
            <p>Email: <Detail value={null} label="Privacy email" /></p>
          )}
        </>
      )}
    </div>
  </section>
</Base>
