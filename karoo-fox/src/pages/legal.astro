---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Detail from '../components/Detail.astro';
import { company, entityStatement, legalName } from '../config/company.ts';
import { apps } from '../data/apps.ts';
import { appPaths, formatDate, href } from '../lib/url.ts';
---
<Base title="Company information" description="Legal and registration information for Karoo Fox, and links to every privacy policy.">
  <PageHeader title="Company information" eyebrow="Legal" lead={entityStatement()} crumbs={[{ label: 'Company information' }]} />
  <section class="section" aria-label="Registration">
    <div class="narrow stack">
      <h2>Registered company</h2>
      <dl class="facts">
        <div><dt>Registered name</dt><dd>{legalName()}</dd></div>
        <div><dt>Brand</dt><dd>{company.brand}</dd></div>
        <div><dt>Company type</dt><dd>Private company (Pty) Ltd</dd></div>
        <div><dt>Registered in</dt><dd>{company.country} (Companies and Intellectual Property Commission)</dd></div>
        <div><dt>Registration number</dt><dd><Detail value={company.registrationNumber} label="CIPC registration number" /></dd></div>
        <div><dt>Address</dt><dd>{company.address ? company.address.join(', ') : <Detail value={null} label="Business address" />}</dd></div>
        <div><dt>Contact</dt><dd><Detail value={company.emails.general} label="Business email" email /></dd></div>
        <div><dt>Information Officer (POPIA)</dt><dd><Detail value={company.informationOfficer} label="Information Officer" /></dd></div>
      </dl>
      {!company.nameAmendmentComplete && (
        <p class="muted">The name {company.nameReservation.name} has been reserved with the Companies and Intellectual Property Commission (name reservation reference {company.nameReservation.reference}, valid until {formatDate(company.nameReservation.validUntil)}). The change of the company’s registered name to {company.futureLegalName} has not yet been completed; until it is, contracts and invoices are issued by {company.currentLegalName}.</p>
      )}
      <h2>Privacy policies</h2>
      <ul>
        <li><a href={href('/privacy/website/')}>Karoo Fox website privacy notice</a></li>
        {apps.map((a) => <li><a href={href(appPaths(a.slug).privacy)}>{a.name} privacy</a></li>)}
      </ul>
      <h2>Trademarks</h2>
      <p>Karoo Fox, the fox logo and our app names are brand marks of the company. Some app names are working names. App Store is a service mark of Apple Inc. Google Play is a trademark of Google LLC.</p>
    </div>
  </section>
</Base>
