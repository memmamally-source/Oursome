---
import { company, entityStatement } from '../config/company.ts';
import { apps } from '../data/apps.ts';
import { appPaths, href } from '../lib/url.ts';
import Detail from './Detail.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const copyrightYears = year > company.since ? `${company.since}–${year}` : `${company.since}`;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <Logo class="footer-logo" height={72} loading="lazy" />
        <p>Independent software from South Africa, made for people everywhere.</p>
      </div>
      <div>
        <h2>Apps</h2>
        <ul>
          {apps.map((app) => <li><a href={href(appPaths(app.slug).page)}>{app.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Help</h2>
        <ul>
          <li><a href={href('/support/')}>Support Centre</a></li>
          <li><a href={href('/support/data-deletion/')}>Delete your data</a></li>
          <li><a href={href('/contact/')}>Contact us</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href={href('/about/')}>About Karoo Fox</a></li>
          <li><a href={href('/news/')}>News</a></li>
          <li><a href={href('/legal/')}>Company information</a></li>
          <li><a href={href('/privacy/')}>Privacy</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-legal">
    <div class="container">
      <p>{entityStatement()}</p>
      <p>Registration number: <Detail value={company.registrationNumber} label="CIPC registration number" /></p>
      <p>© {copyrightYears} {company.nameAmendmentComplete ? company.futureLegalName : company.currentLegalName}. Karoo Fox and the fox logo are brand marks of the company. App Store is a service mark of Apple Inc. Google Play is a trademark of Google LLC.</p>
    </div>
  </div>
</footer>
