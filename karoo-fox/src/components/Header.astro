---
import { mainNav } from '../config/nav.ts';
import { href } from '../lib/url.ts';
const current = Astro.url.pathname;
const isCurrent = (path: string) => current === href(path) || current.startsWith(href(path));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand-link" href={href('/')}>
      <picture>
        <source srcset={href('/brand/logo-horizontal-light.svg')} media="(prefers-color-scheme: dark)" />
        <img src={href('/brand/logo-horizontal.svg')} alt="Karoo Fox home" width="153" height="40" />
      </picture>
    </a>
    <nav class="desktop-nav" aria-label="Main">
      <ul class="nav-list">
        {mainNav.map((item) => <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Menu">Menu</summary>
      <nav aria-label="Main (mobile)">
        <ul class="nav-list">
          {mainNav.map((item) => <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
