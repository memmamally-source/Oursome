{
  "name": "oursome",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.4.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "firebase": "^13.1.0",
    "jest-expo": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "ionicons": "^7.4.0",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test -- --ci",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "build:web": "node scripts/build-web.js",
    "icons": "node scripts/generate-icons.js",
    "eval:ai": "jest src/features/assistant/__tests__/scenarios.test.ts",
    "check:server": "npm --prefix server/ai run typecheck && npm --prefix server/ai test",
    "test:cloud": "cd firebase && npx --yes firebase-tools@15 emulators:exec --only firestore,auth --project demo-oursome \"cd .. && npx jest -c firebase/jest.config.js\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/",
      "<rootDir>/firebase/"
    ]
  }
}
